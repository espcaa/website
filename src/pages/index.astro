---
const start = performance.now();
import { SITE_DESCRIPTION, SITE_TITLE } from "../consts";
import "../styles/global.css";
import Icon from "../components/Icon.astro";
import Button from "../components/Button.astro";

// arrows
import arrowImage from "../assets/arrow.png";
import "../styles/scrollbar.css";
import arrowImage2 from "../assets/arrow2.png";
import arrowImage3 from "../assets/arrow3.png";

import {
    getColorFromFilename,
    getRandomWallpaperIndex,
} from "../../utils/wallpaper";

export const prerender = false;

import Projects from "../components/Projects.astro";
import Writings from "../components/Writings.astro";
import { getCollection } from "astro:content";
const placesData = await getCollection("places");

const gitInfo = getCommitInfo();

const randomIndex = getRandomWallpaperIndex();
const wallpaperStringPath = `/wallpapers/${randomIndex}.webp`;
console.log(randomIndex.toString());
const colors = await getColorFromFilename(randomIndex.toString());
import pfp from "../assets/pfp.png";
import Map from "../components/Map";
import { getCommitInfo } from "../utils/github";
import Image from "astro/components/Image.astro";

const places = placesData.map((place) => ({
    ...place,
    data: {
        ...place.data,
        link: `/places/${place.id}?color=${randomIndex}`,
    },
}));

const wallpaperMetadata = await import(
    `../data/wallpapers/${randomIndex}.json`
);

const end = performance.now();
const ssrTime = end - start;
---

<!doctype html>
<html lang="en" style={`background-color: ${colors.background};`}>
    <head>
        <meta charset="UTF-8" />

        <meta name="viewport" content="width=device-width, initial-scale=1.0" />
        <title>{SITE_TITLE}</title>
        <meta name="description" content={SITE_DESCRIPTION} />
        <link rel="shortcut icon" href="/favicon.png" type="image/x-icon" />
        <link rel="icon" type="image/png" href="/favicon.png" />
    </head>
    <body
        style={`margin:0;
           --primary: ${colors.primary};
           --on-primary: ${colors.onPrimary};
           --secondary: ${colors.secondary};
           --on-secondary: ${colors.onSecondary};
           --tertiary: ${colors.tertiary};
           --on-tertiary: ${colors.onTertiary};
           --background: ${colors.background};
           --on-background: ${colors.onBackground};
           --surface: ${colors.surface};
           --on-surface: ${colors.onSurface};
    `}
    >
        <div class="container">
            <div class="header">
                <div class="pfpcontainer">
                    <Image src={pfp} alt="Profile Picture" class="pfp" />
                </div>
                <div class="headercontent">
                    <div class="headertop">
                        <div class="nameContainer">
                            <h1 class="title">Alice</h1>
                            <p class="githubhandle">@espcaa</p>
                        </div>
                        <div class="m3colors">
                            {
                                (
                                    [
                                        ["Primary", colors.primary],
                                        ["Secondary", colors.secondary],
                                        ["Tertiary", colors.tertiary],
                                    ] as const
                                ).map(([role, hex]) => {
                                    const r = parseInt(hex.slice(1, 3), 16);
                                    const g = parseInt(hex.slice(3, 5), 16);
                                    const b = parseInt(hex.slice(5, 7), 16);
                                    return (
                                        <div
                                            class="color"
                                            style={`background-color: ${hex};`}
                                        >
                                            <div class="popup">
                                                <p class="popup-role">{role}</p>
                                                <p class="popup-hex">
                                                    {hex.toUpperCase()}
                                                </p>
                                                <p class="popup-rgb">
                                                    rgb({r}, {g}, {b})
                                                </p>
                                            </div>
                                        </div>
                                    );
                                })
                            }
                            <div class="m3note">
                                <Image
                                    src={arrowImage3}
                                    alt="arrow"
                                    class="arrow3"
                                    width={853.4}
                                    height={698.7}
                                />
                                <p class="notice" style="font-size: 1.2rem;">
                                    those colors change on every reload!
                                </p>
                            </div>
                        </div>
                    </div>
                    <div class="headerbottom">
                        <Button
                            href="https://github.com/espcaa"
                            text="Github"
                            icon="arrow_out"
                        />
                        <Button
                            href="mailto:alice@hackclub.cc"
                            text="Email"
                            icon="arrow_out_2"
                        />
                        <Image
                            src={arrowImage2}
                            alt="arrow"
                            class="arrow2"
                            width={838.9}
                            height={457.7}
                        />
                        <div class="emailnote">
                            <p class="notice">say hi!</p>
                        </div>
                    </div>
                </div>
            </div>
            <div class="body">
                <div class="about">
                    <h2>About Me</h2>
                    <p>
                        Hi! I'm Alice :D <br /> I spend most of my days (and often
                        nights) trying to build software (or hardware) that (sometimes)
                        works. I also like exploring new places (see the map!) or
                        doing some random things like rock climbing. <br /> I also
                        spend a shit ton of time yapping and building things on <a
                            href="https://hackclub.com">hackclub</a
                        >'s slack. <br />
                        Today, I coded for <em id="waka-time">0h 0m</em>!
                    </p>
                    <h2
                        class="projectHeader"
                        style="position: relative; display: inline-block;"
                    >
                        <Image
                            width={245.3}
                            height={631.1}
                            class="arrow"
                            src={arrowImage}
                            alt="arrow"
                        />
                        <p class="arrowText notice">best</p>
                        My &nbsp;Projects
                    </h2>
                    <Projects colorId={randomIndex} />
                    <h2>Places i've been to</h2>
                    <p>
                        I mostly travel on my own to attend hackclub events and
                        hackathons!
                    </p>
                    <p>
                        Explore the map (or use the buttons below) to see
                        everywhere I've been to + writings/thoughts about each
                        place!
                    </p>
                    <Map
                        landColor={colors.onBackground}
                        waterColor={colors.onPrimary}
                        client:load
                        borderColor={colors.background}
                        places={places}
                    />
                    <div class="placeslist">
                        {
                            places.map((place) => (
                                <Button
                                    href={place.data.link}
                                    text={place.data.name}
                                    icon="arrow_out"
                                />
                            ))
                        }
                    </div>
                    <h2>Random section</h2>
                    <Writings colorId={randomIndex} />

                    <h2>Nerdy stats</h2>
                    <ul>
                        <li>
                            Most of the data like project & places on this
                            website are just markdown files!
                        </li>
                        <li>
                            I coded for <em id="waka-seconds">0</em> seconds today!
                            (data sourced from hackclub's wakatime instance)
                        </li>
                        <li>
                            <a href={gitInfo?.url}
                                >the latest commit to this website</a
                            > was <em class="sha">
                                {gitInfo?.sha}
                                - {gitInfo?.text}</em
                            >
                        </li>
                        <li>
                            SSR took {ssrTime.toFixed(2)}ms to render this page!
                        </li>
                    </ul>
                </div>
            </div>
        </div>
        <div class="bg">
            <img
                src={wallpaperStringPath}
                alt="Random wallpaper"
                class="bgimg"
            />
        </div>
        <div class="picture-info">
            <p>
                {wallpaperMetadata.what}
            </p>
            <p>
                {wallpaperMetadata.where}
            </p>
            <p>
                {wallpaperMetadata.date}
            </p>
        </div>
        <script>
            // formats time <hours>h <minutes>m
            const secondsToHumanReadable = (seconds_waka: number) => {
                const totalSeconds = seconds_waka;
                const hours = Math.floor(totalSeconds / 3600);
                const minutes = Math.floor((totalSeconds % 3600) / 60);
                const seconds = totalSeconds % 60;
                return `${hours}h ${minutes}m`;
            };

            let wakatime_seconds = 0;
            // fetch the wakatime data
            await fetch("/api/hackatime")
                .then((response) => response.json())
                .then((data) => {
                    // get the seconds
                    wakatime_seconds = data.wakatime_seconds;
                })
                .catch((error) => {
                    wakatime_seconds = 0;
                });

            // set the human readable thingy
            //
            document.getElementById("waka-seconds")!.innerText =
                wakatime_seconds.toString();
            document.getElementById("waka-time")!.innerText =
                secondsToHumanReadable(wakatime_seconds);
        </script>
    </body>
</html>
